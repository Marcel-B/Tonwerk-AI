      "title": "Protokoll",
      "id": 22,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "{app=\"finanzomat\", source=~\"$source\", level=~\"$level\"} |= `$search`",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Quelle",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "server,zugriff,web,paperless,verzeichnis,neu_einlesen,einstellungen,belegnummern,aktualisierung,backup",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Stufe",
        "type": "custom",
        "multi": true,
