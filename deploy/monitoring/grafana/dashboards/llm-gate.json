      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(llmgate_tonwerk_idle{app=\"llm-gate\"}) + 2 * (1 - max(llmgate_tonwerk_reachable{app=\"llm-gate\"}))",
