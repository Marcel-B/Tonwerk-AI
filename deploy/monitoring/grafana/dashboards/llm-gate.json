        "allValue": ".+",
        "query": "info,warning,error",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "source",
        "label": "Quelle",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "queue,models,tonwerk,config",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Suche",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
