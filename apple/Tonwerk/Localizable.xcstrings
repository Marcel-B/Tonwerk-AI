    "Summen, pfeifen, singen oder einen Song wählen: ACE-Step hört zu und füllt Beschreibung, Text, Tempo, Tonart, Takt und Länge aus. Die Melodie selbst wird nicht übernommen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summen, pfeifen, singen oder einen Song wählen: ACE-Step hört zu und füllt Beschreibung, Text, Tempo, Tonart, Takt und Länge aus. Die Melodie selbst wird nicht übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum, whistle, sing or pick a song: ACE-Step listens and fills in description, lyrics, tempo, key, metre and length. The melody itself is not carried over."
          }
        }
      }
    },
