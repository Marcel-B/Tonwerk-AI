# Copy to .env and fill in. .env stays out of git.
# Grafana's admin login.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
# Only on the Tailscale address instead of every interface, e.g. 100.64.0.12:
# BIND_ADDRESS=0.0.0.0
# PROMETHEUS_RETENTION=90d
# The push gate for devices outside the tailnet (loki-push/, port 3101); every interface unless set:
# LOKI_PUSH_BIND=0.0.0.0
# Where Grafana sends alarms: the ntfy server (Slipways' on slipways-1) and a topic with a random part, since anyone
# in the tailnet who knows the name can read it. proxmox-lxc.sh asks for both.
NTFY_URL=https://slipways-1.<tailnet>.ts.net:2586
NTFY_TOPIC=alarme-<zufall>
