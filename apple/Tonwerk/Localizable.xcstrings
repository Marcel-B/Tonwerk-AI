    },
    "Schreibt" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt"
          }
        },
        "en" : {
          "stringUnit" : {
