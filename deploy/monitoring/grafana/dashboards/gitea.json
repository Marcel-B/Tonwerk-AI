    {
      "type": "stat",
      "title": "Erreichbar",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(up{app=\"gitea\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "decimals": 0,
          "noValue": "kein Ziel",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "nein",
                  "color": "red"
                },
                "1": {
                  "text": "ja",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Ob Prometheus /metrics von Gitea erreicht (Job gitea, mit dem Token aus [metrics] TOKEN). „nein“ heißt: Gitea aus, aus dem Netz von monitoring nicht erreichbar oder der Token passt nicht (Prometheus: Targets)."
    },
