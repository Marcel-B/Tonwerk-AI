    },
    {
      "type": "table",
      "title": "Geladene Modelle",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "llmgate_model_loaded{app=\"llm-gate\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "expr": "llmgate_model_ram_bytes{app=\"llm-gate\"} * on (model, backend) group_left (owned) (llmgate_model_loaded{app=\"llm-gate\"} * 0 + 1)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "app": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "model": "Modell",
              "backend": "Server",
              "owned": "gehört einer App",
              "Value #A": "Instanzen",
              "Value #B": "RAM"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gehört einer App"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "ja"
                      },
                      "0": {
                        "text": "nein (Tonwerk oder von Hand)"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Alles, was in LM Studio und den anderen Servern geladen ist. Nur Modelle, die einer App gehören, darf die Schranke entladen."
    },
