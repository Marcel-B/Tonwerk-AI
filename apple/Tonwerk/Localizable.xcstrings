    "Hallo, das ist meine Stimme. Ich lese diesen Satz ruhig und deutlich vor, damit das Modell hören kann, wie ich klinge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo, das ist meine Stimme. Ich lese diesen Satz ruhig und deutlich vor, damit das Modell hören kann, wie ich klinge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello, this is my voice. I am reading this sentence calmly and clearly, so that the model can hear what I sound like."
          }
        }
      }
    },
