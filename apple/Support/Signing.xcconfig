// The team that signs the app for an iPhone. The repository is public, so the team's id stays out of it: put it into
// Local.xcconfig next to this file (ignored by git), one line:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// and leave the team empty in Xcode's "Signing & Capabilities", which would write it into the project.
//
// The Mac build signs ad hoc and needs no team. macOS then keys a privacy answer (the microphone) to the build's hash,
// so every new build asks again; and it asks on the first sound already when the output is a device with inputs too
// (an audio interface such as a Focusrite), since Core Audio opens its input side with the output. Signed by a team,
// the answer stays with the app across builds: Local.xcconfig can say
//
//     CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development
CODE_SIGN_IDENTITY[sdk=macosx*] = -

// Sparkle's public EdDSA key for the Mac app's updates (Updates.swift). Empty here, so a build from Xcode has no
// updater; release-mac.yml passes the key from the secret SPARKLE_PUBLIC_ED_KEY.
SPARKLE_PUBLIC_ED_KEY =

#include? "Local.xcconfig"
