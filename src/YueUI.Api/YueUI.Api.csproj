<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Vue frontend (Vite). In development SpaProxy starts its dev server; dotnet publish bundles it into wwwroot/ui. -->
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**;$(SpaRoot)dist\**</DefaultItemExcludes>
    <!-- Pass -p:SkipClientAppBuild=true when the frontend is built separately. -->
    <SkipClientAppBuild Condition="'$(SkipClientAppBuild)' == ''">false</SkipClientAppBuild>
    <SpaProxyServerUrl>http://127.0.0.1:5174/ui/</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(SpaRoot)**" />
    <Content Remove="$(SpaRoot)**" />
    <EmbeddedResource Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot)dist\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Run by YuE Studio's Python in front of its worker (PythonWorkerLauncher.ExtensionScript). -->
    <None Update="Worker\yueui_worker.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Worker\yueui_lora.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Worker\yueui_lora_train.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Speech\yueui_speech.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Images\yueui_image.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="AudioMidi\yueui_basicpitch.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Timing\yueui_whisper.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Video\yueui_montage.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- Seed-VC's conversion, run with its own Python (SeedVcEngine.Script). -->
    <None Update="Voices\yueui_seedvc.py" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Voices\stem-models.json" LogicalName="stem-models.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logic Pro projects and MIDI → ABC; formerly the separate yue-to-logic-pro service. -->
    <ProjectReference Include="..\YueToLogic.Core\YueToLogic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Tags and covers in exported MP3, M4A and FLAC files. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- SpaProxy runs "npm run dev" but does not install packages; do that once for a fresh checkout. -->
  <Target Name="EnsureClientAppDependencies" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(SkipClientAppBuild)' != 'true' And !Exists('$(SpaRoot)node_modules')">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Warning Condition="'$(NodeExitCode)' != '0'" Text="Node.js was not found, so the web interface cannot run. Install Node.js 22.12 or later from https://nodejs.org/." />
    <Message Condition="'$(NodeExitCode)' == '0'" Importance="high" Text="Installing the web interface's npm packages (first build only) ..." />
    <Exec Condition="'$(NodeExitCode)' == '0'" WorkingDirectory="$(SpaRoot)" Command="npm ci" />
  </Target>

  <!-- dotnet publish: build the frontend and ship it as wwwroot/ui. -->
  <Target Name="PublishClientApp" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipClientAppBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientAppDistFiles Include="$(MSBuildThisFileDirectory)$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(ClientAppDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/ui/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
