        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Ob Prometheus /metrics der Schranke auf oi-o-mat erreicht (Port 1235)."
