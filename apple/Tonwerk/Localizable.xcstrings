          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phrase “Sing” kept of your recording (3 to 12 s) becomes a voice for versions and “Swap a vocal track”. For the full sound, rather upload the whole recording."
