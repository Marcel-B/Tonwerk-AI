    "Ordner liegen in %@ auf dem Mac. Ein Motiv wählt passende Bilder, leer nimmt die schärfsten. Geschnitten wird auf den Takt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner liegen in %@ auf dem Mac. Ein Motiv wählt passende Bilder, leer nimmt die schärfsten. Geschnitten wird auf den Takt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders are in %@ on the Mac. A motif picks fitting pictures; empty takes the sharpest. Cuts fall on the beat."
          }
        }
      }
