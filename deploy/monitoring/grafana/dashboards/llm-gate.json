        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Was die Schranke von Tonwerks /api/idle weiß. Arbeitet Tonwerk, hält sie Anfragen der Apps zurück, die dabei weichen."
    },
    {
      "type": "stat",
      "title": "Apps-Modelle (RAM)",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(llmgate_model_ram_bytes{app=\"llm-gate\"} and on (model, backend) llmgate_model_loaded{app=\"llm-gate\",owned=\"1\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Geschätzter RAM der geladenen Modelle, die Apps gehören; das zählt gegen ramBudgetGb."
