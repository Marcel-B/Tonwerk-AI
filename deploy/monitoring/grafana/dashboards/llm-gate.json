          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "still",
                  "color": "green"
                },
                "0": {
                  "text": "arbeitet",
                  "color": "orange"
                },
                "2": {
                  "text": "antwortet nicht",
                  "color": "red"
                },
                "3": {
                  "text": "antwortet nicht",
                  "color": "red"
                }
