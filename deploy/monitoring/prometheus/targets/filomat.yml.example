# Copy to filomat.yml and put in the Tailscale name of fil-o-mat's container. Since 2026-11-25 that is the Rust
# backend (gitea.idsrv.info/Marcel/fil-o-mat, LXC filomat-rs) behind tailscale serve: https on 443, /metrics with
# FILOMAT_METRICS=1. The old .NET backend (port 8080, plain http) is gone.
- targets: [filomat-rs.example.ts.net]
  labels:
    app: filomat
    __scheme__: https
    __metrics_path__: /metrics
