          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Antworten mit Status 5xx pro Stunde."
    },
    {
      "type": "bargauge",
      "title": "Langsamste Routen (Mittel)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "topk(8, sum by (route) (increase(finanzomat_http_request_duration_seconds_sum{app=\"finanzomat\",route!=\"/metrics\"}[$__range])) / (sum by (route) (increase(finanzomat_http_request_duration_seconds_count{app=\"finanzomat\",route!=\"/metrics\"}[$__range])) > 0))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Mittlere Dauer je Route im gewählten Zeitraum."
