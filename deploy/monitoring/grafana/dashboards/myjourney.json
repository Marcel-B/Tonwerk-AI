{
  "title": "MyJourney",
  "uid": "myjourney",
  "tags": ["myjourney"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Stufe",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "debug,info,warning,error",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Suche",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Jetzt",
      "id": 1,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Erreichbar",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "max(up{app=\"myjourney\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "nein", "color": "red" },
                "1": { "text": "ja", "color": "green" }
              }
            }
          ],
          "noValue": "kein Ziel",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Ob Prometheus /metrics der App abrufen kann."
    },
    {
      "type": "stat",
      "title": "Wunschliste",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "max(myjourney_places{app=\"myjourney\",status=\"wishlist\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Orte auf der Wunschliste."
    },
    {
      "type": "stat",
      "title": "Besucht",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "max(myjourney_places{app=\"myjourney\",status=\"visited\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Bereits besuchte Orte."
    },
    {
      "type": "stat",
      "title": "Reisen",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "max(myjourney_trips{app=\"myjourney\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Angelegte Reisen."
    },
    {
      "type": "stat",
      "title": "Live-Verbindungen",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "max(myjourney_live_clients{app=\"myjourney\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Offene Live-Update-Verbindungen (/api/events), also gerade geöffnete Browser/Apps."
    },
    {
      "type": "stat",
      "title": "Fehler (24 h)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(http_requests_received_total{app=\"myjourney\",code=~\"5..\"}[24h])) or vector(0)",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Antworten mit Status 5xx in den letzten 24 Stunden."
    },
    {
      "type": "row",
      "title": "Nutzung",
      "id": 8,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Anfragen pro Minute",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(http_requests_received_total{app=\"myjourney\",endpoint!=\"/metrics\"}[5m])) * 60 > 0",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Ohne die Abrufe von Prometheus."
    },
    {
      "type": "timeseries",
      "title": "Antwortzeit",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"myjourney\",endpoint!=\"/metrics\"}[5m])))",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "Median"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"myjourney\",endpoint!=\"/metrics\"}[5m])))",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "95 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": ""
    },
    {
      "type": "timeseries",
      "title": "Fehlerhafte Anfragen",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (endpoint, code) (increase(http_requests_received_total{app=\"myjourney\",code=~\"5..\"}[1h])) > 0",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{endpoint}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "drawStyle": "bars" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Antworten mit Status 5xx pro Stunde."
    },
    {
      "type": "timeseries",
      "title": "Datenänderungen",
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum(increase(myjourney_data_changes_total{app=\"myjourney\"}[1h]))",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "Änderungen pro Stunde"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "drawStyle": "bars" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Gespeicherte Änderungen an Orten, Reisen und Stopps."
    },
    {
      "type": "row",
      "title": "Bestand",
      "id": 13,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Orte und Reisen",
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "max by (status) (myjourney_places{app=\"myjourney\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "Orte: {{status}}"
        },
        {
          "expr": "max(myjourney_trips{app=\"myjourney\"})",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "Reisen"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Bestand in der Datenbank über die Zeit."
    },
    {
      "type": "timeseries",
      "title": "Nextcloud-Backups",
      "id": 15,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum by (result) (increase(myjourney_backup_runs_total{app=\"myjourney\"}[1d]))",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "drawStyle": "bars" },
          "decimals": 0,
          "noValue": "noch kein Lauf"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ok" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Backup-Läufe pro Tag nach Ergebnis; erscheint erst nach dem ersten Lauf seit App-Start."
    },
    {
      "type": "row",
      "title": "Server",
      "id": 16,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Arbeitsspeicher",
      "id": 17,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "process_working_set_bytes{app=\"myjourney\"}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "App"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": ""
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "id": 18,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{app=\"myjourney\"}[5m])",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "App"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": ""
    },
    {
      "type": "row",
      "title": "Protokoll",
      "id": 19,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Warnungen und Fehler",
      "id": 20,
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({app=\"myjourney\", level=~\"warning|error\"}[5m]))",
          "queryType": "range",
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "drawStyle": "bars" },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "description": "Logzeilen mit Stufe warning oder error aus Loki."
    },
    {
      "type": "logs",
      "title": "Protokoll",
      "id": 21,
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 43 },
      "targets": [
        {
          "expr": "{app=\"myjourney\", level=~\"$level\"} |= `$search`",
          "queryType": "range",
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
