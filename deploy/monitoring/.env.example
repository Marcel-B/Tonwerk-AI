# Copy to .env and fill in. .env stays out of git.
# Grafana's admin login.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
# Only on the Tailscale address instead of every interface, e.g. 100.64.0.12:
# BIND_ADDRESS=0.0.0.0
# PROMETHEUS_RETENTION=90d
# The push gate for devices outside the tailnet (loki-push/, port 3101); every interface unless set:
# LOKI_PUSH_BIND=0.0.0.0
# Where Grafana sends alarms: Onkel Bummel and a publish token for its topic alarme, made in Onkel Bummel's container
# with `dotnet OnkelBummel.Api.dll --create-token grafana alarme`. proxmox-lxc.sh asks for both.
ONKELBUMMEL_URL=https://onkel-bummel.<tailnet>.ts.net
ONKELBUMMEL_TOKEN=ob_…
