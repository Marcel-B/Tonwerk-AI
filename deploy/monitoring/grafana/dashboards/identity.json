      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "decimals": 0,
          "noValue": "kein Ziel",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "nein",
                  "color": "red"
                },
                "1": {
                  "text": "ja",
                  "color": "green"
                }
              }
            }
          ]
