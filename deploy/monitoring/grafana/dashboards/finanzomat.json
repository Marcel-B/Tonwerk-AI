    {
      "type": "timeseries",
      "title": "Anfragen pro Minute",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(finanzomat_http_requests_total{app=\"finanzomat\",route!=\"/metrics\"}[5m])) * 60 > 0",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Ohne die Abrufe von Prometheus."
    },
    {
      "type": "timeseries",
      "title": "Antwortzeit",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(finanzomat_http_request_duration_seconds_bucket{app=\"finanzomat\",route!=\"/metrics\"}[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Median"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(finanzomat_http_request_duration_seconds_bucket{app=\"finanzomat\",route!=\"/metrics\"}[5m])))",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "95 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "type": "timeseries",
      "title": "Fehlerhafte Anfragen",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
