    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonwerk-AI nimmt deine Stimme nur auf, wenn du im Sprachlabor oder beim Singen „Aufnehmen“ wählst: als Vorlage für die Sprachmodelle oder als eigene Singstimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonwerk-AI only records your voice when you choose “Record” in the speech lab or when singing: as a reference for the speech models or as your own singing voice."
          }
        }
      }
    }
